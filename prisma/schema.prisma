generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum OrgPlan {
  free
  pro
  business
}

enum UserRole {
  owner
  admin
  agent
  viewer
}

enum TicketStatus {
  new
  open
  in_progress
  pending
  resolved
  closed
}

enum TicketPriority {
  low
  medium
  high
  urgent
}

enum TicketSentiment {
  positive
  neutral
  negative
  frustrated
  satisfied
}

enum TicketChannel {
  web
  email
  chat
  whatsapp
  sms
  slack
  teams
}

enum ArticleStatus {
  draft
  published
  review
  archived
}

enum ArticleVisibility {
  public
  internal
  private
}

enum AnnouncementType {
  info
  warning
  maintenance
  feature
}

enum CustomerEmailStatus {
  active
  bounced
  unsubscribed
  complained
}

enum EmailOutboundProvider {
  ses
  smtp
  sendgrid
  mailgun
  postmark
}

enum EmailProcessingStatus {
  pending
  processing
  processed
  failed
  spam
}

enum EmailDirection {
  inbound
  outbound
}

enum EmailMessageStatus {
  pending
  queued
  sent
  delivered
  failed
  bounced
  rejected
  spam
}

enum EmailDeliveryEventType {
  queued
  sent
  delivered
  opened
  clicked
  bounced
  rejected
  complained
  deferred
}

enum EmailQueueStatus {
  pending
  processing
  sent
  failed
  dead
}

// ============================================================
// IDENTITY (NextAuth-owned + app identity fork)
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  passwordHash  String?   @map("password_hash")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  profile             Profile?
  customer            Customer?
  auditLogs           AuditLog[]
  aiUsageLogs         AiUsageLog[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ============================================================
// ORGANIZATIONS
// ============================================================

model Organization {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  plan          OrgPlan   @default(free)
  website       String?
  timezone      String    @default("UTC")
  country       String?
  supportEmail  String?   @map("support_email")
  logoUrl       String?   @map("logo_url")
  ticketPrefix  String    @default("SUP") @map("ticket_prefix")
  ticketCounter BigInt    @default(1001) @map("ticket_counter")
  freepassPlan  String?   @map("freepass_plan")
  freepassUntil DateTime? @map("freepass_until")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  profiles          Profile[]
  invitations       Invitation[]
  customers         Customer[]
  tickets           Ticket[]
  knowledgeArticles KnowledgeArticle[]
  subscription      Subscription?
  aiUsageLogs       AiUsageLog[]
  auditLogs         AuditLog[]
  departments       Department[]
  ticketTemplates   TicketTemplate[]
  savedViews        SavedView[]
  ticketAttachments TicketAttachment[]
  announcements     Announcement[]
  kbCategories      KbCategory[]
  emailSettings     EmailSettings?
  emailRawInbound   EmailRawInbound[]
  emailMessages     EmailMessage[]
  emailAttachments  EmailAttachment[]
  emailQueueItems   EmailQueue[]
  emailTemplates    EmailTemplate[]
  apiKeys           ApiKey[]
  outboundWebhooks  OutboundWebhook[]

  @@map("organizations")
}

// ============================================================
// PROFILES (agent identity)
// ============================================================

model Profile {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  organizationId String   @map("org_id")
  role           UserRole @default(agent)
  fullName       String   @map("full_name")
  avatarUrl      String?  @map("avatar_url")
  email          String
  timezone       String   @default("UTC")
  language       String   @default("en")
  phone          String?
  jobTitle       String?  @map("job_title")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  invitationsSent         Invitation[]
  assignedTickets         Ticket[]           @relation("TicketAssignee")
  authoredMessages        TicketMessage[]    @relation("MessageAuthor")
  authoredArticles        KnowledgeArticle[] @relation("ArticleAuthor")
  createdTicketTemplates  TicketTemplate[]
  savedViews              SavedView[]
  createdTicketRelations  TicketRelation[]
  uploadedAttachments     TicketAttachment[]
  createdAnnouncements    Announcement[]
  authoredArticleVersions ArticleVersion[]
  createdApiKeys          ApiKey[]
  createdWebhooks         OutboundWebhook[]

  @@index([organizationId])
  @@map("profiles")
}

// ============================================================
// INVITATIONS
// ============================================================

model Invitation {
  id             String    @id @default(cuid())
  organizationId String    @map("org_id")
  email          String
  role           UserRole  @default(agent)
  token          String    @unique @default(cuid())
  invitedById    String    @map("invited_by")
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    Profile      @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([token])
  @@map("invitations")
}

// ============================================================
// CUSTOMERS (portal identity)
// ============================================================

model Customer {
  id             String              @id @default(cuid())
  organizationId String              @map("org_id")
  userId         String?             @unique @map("user_id")
  name           String
  email          String
  phone          String?
  company        String?
  notes          String?
  emailStatus    CustomerEmailStatus @default(active) @map("email_status")
  emailBouncedAt DateTime?           @map("email_bounced_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @default(now()) @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  tickets         Ticket[]
  ticketRatings   TicketRating[]
  articleFeedback ArticleFeedback[]

  @@unique([organizationId, email])
  @@map("customers")
}

// ============================================================
// TICKETS
// ============================================================

model Ticket {
  id                   String                   @id @default(cuid())
  organizationId       String                   @map("org_id")
  customerId           String?                  @map("customer_id")
  assigneeId           String?                  @map("assignee_id")
  title                String
  description          String                   @default("")
  status               TicketStatus             @default(open)
  priority             TicketPriority           @default(medium)
  category             String?
  tags                 String[]                 @default([])
  ticketNumber         String?                  @map("ticket_number")
  department           String?
  source               String                   @default("manual")
  dueDate              DateTime?                @map("due_date")
  firstResponseAt      DateTime?                @map("first_response_at")
  resolvedAt           DateTime?                @map("resolved_at")
  closedAt             DateTime?                @map("closed_at")
  isSpam               Boolean                  @default(false) @map("is_spam")
  searchVector         Unsupported("tsvector")? @map("search_vector")
  sentiment            TicketSentiment?
  channel              TicketChannel            @default(web)
  sourceEmailMessageId String?                  @map("source_email_message_id")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @default(now()) @updatedAt @map("updated_at")

  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer           Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignee           Profile?      @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  sourceEmailMessage EmailMessage? @relation("TicketSourceEmail", fields: [sourceEmailMessageId], references: [id], onDelete: SetNull)

  messages          TicketMessage[]
  attachments       TicketAttachment[]
  relationsAsSource TicketRelation[]   @relation("TicketRelationSource")
  relationsAsTarget TicketRelation[]   @relation("TicketRelationTarget")
  rating            TicketRating?
  emailMessages     EmailMessage[]     @relation("EmailMessageTicket")
  emailAttachments  EmailAttachment[]
  emailQueueItems   EmailQueue[]
  aiUsageLogs       AiUsageLog[]

  @@unique([organizationId, ticketNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, assigneeId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("tickets")
}

// ============================================================
// TICKET MESSAGES
// ============================================================

model TicketMessage {
  id         String    @id @default(cuid())
  ticketId   String    @map("ticket_id")
  authorId   String?   @map("author_id")
  content    String
  isAi       Boolean   @default(false) @map("is_ai")
  isCustomer Boolean   @default(false) @map("is_customer")
  isInternal Boolean   @default(false) @map("is_internal")
  editedAt   DateTime? @map("edited_at")
  metadata   Json      @default("{}")
  createdAt  DateTime  @default(now()) @map("created_at")

  ticket Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author Profile? @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  attachments TicketAttachment[]

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

// ============================================================
// TICKET SUPPORTING TABLES
// ============================================================

model Department {
  id             String   @id @default(cuid())
  organizationId String   @map("org_id")
  name           String
  description    String?
  color          String   @default("#6366f1")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("departments")
}

model TicketTemplate {
  id             String   @id @default(cuid())
  organizationId String   @map("org_id")
  name           String
  subject        String
  body           String
  category       String?
  department     String?
  priority       String   @default("medium")
  tags           String[] @default([])
  createdById    String?  @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    Profile?     @relation(fields: [createdById], references: [id])

  @@index([organizationId])
  @@map("ticket_templates")
}

model SavedView {
  id             String   @id @default(cuid())
  organizationId String   @map("org_id")
  userId         String?  @map("user_id")
  name           String
  filters        Json     @default("{}")
  isShared       Boolean  @default(false) @map("is_shared")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         Profile?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("saved_views")
}

model TicketRelation {
  id           String   @id @default(cuid())
  ticketId     String   @map("ticket_id")
  relatedId    String   @map("related_id")
  relationType String   @map("relation_type")
  createdById  String?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  ticket    Ticket   @relation("TicketRelationSource", fields: [ticketId], references: [id], onDelete: Cascade)
  related   Ticket   @relation("TicketRelationTarget", fields: [relatedId], references: [id], onDelete: Cascade)
  createdBy Profile? @relation(fields: [createdById], references: [id])

  @@unique([ticketId, relatedId, relationType])
  @@map("ticket_relations")
}

model TicketAttachment {
  id             String   @id @default(cuid())
  ticketId       String   @map("ticket_id")
  messageId      String?  @map("message_id")
  organizationId String   @map("org_id")
  fileName       String   @map("file_name")
  fileSize       BigInt   @map("file_size")
  mimeType       String   @map("mime_type")
  storagePath    String   @map("storage_path")
  uploadedById   String?  @map("uploaded_by")
  createdAt      DateTime @default(now()) @map("created_at")

  ticket       Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message      TicketMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   Profile?       @relation(fields: [uploadedById], references: [id])

  @@index([ticketId])
  @@index([messageId])
  @@map("ticket_attachments")
}

model TicketRating {
  id         String   @id @default(cuid())
  ticketId   String   @unique @map("ticket_id")
  customerId String?  @map("customer_id")
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  ticket   Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@map("ticket_ratings")
}

// ============================================================
// KNOWLEDGE BASE
// ============================================================

model KnowledgeArticle {
  id              String                   @id @default(cuid())
  organizationId  String                   @map("org_id")
  title           String
  content         String                   @default("")
  status          ArticleStatus            @default(draft)
  category        String?
  tags            String[]                 @default([])
  authorId        String                   @map("author_id")
  slug            String?
  excerpt         String?
  coverImageUrl   String?                  @map("cover_image_url")
  visibility      ArticleVisibility        @default(public)
  seoTitle        String?                  @map("seo_title")
  seoDescription  String?                  @map("seo_description")
  readingTimeMin  Int                      @default(1) @map("reading_time_min")
  version         Int                      @default(1)
  viewsCount      Int                      @default(0) @map("views_count")
  helpfulVotes    Int                      @default(0) @map("helpful_votes")
  notHelpfulVotes Int                      @default(0) @map("not_helpful_votes")
  categoryId      String?                  @map("category_id")
  publishedAt     DateTime?                @map("published_at")
  fts             Unsupported("tsvector")?
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @default(now()) @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       Profile      @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  categoryRef  KbCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  versions ArticleVersion[]
  feedback ArticleFeedback[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("knowledge_articles")
}

model KbCategory {
  id             String   @id @default(cuid())
  organizationId String   @map("org_id")
  name           String
  slug           String
  description    String?
  icon           String?
  sortOrder      Int      @default(0) @map("sort_order")
  parentId       String?  @map("parent_id")
  isArchived     Boolean  @default(false) @map("is_archived")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       KbCategory?        @relation("KbCategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children     KbCategory[]       @relation("KbCategoryParent")
  articles     KnowledgeArticle[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("kb_categories")
}

model ArticleVersion {
  id            String   @id @default(cuid())
  articleId     String   @map("article_id")
  versionNumber Int      @map("version_number")
  title         String
  content       String
  changeSummary String?  @map("change_summary")
  authorId      String?  @map("author_id")
  createdAt     DateTime @default(now()) @map("created_at")

  article KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author  Profile?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([articleId, versionNumber])
  @@map("article_versions")
}

model ArticleFeedback {
  id         String   @id @default(cuid())
  articleId  String   @map("article_id")
  customerId String?  @map("customer_id")
  isHelpful  Boolean  @map("is_helpful")
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  article  KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  customer Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([articleId])
  @@map("article_feedback")
}

// ============================================================
// SUBSCRIPTIONS / AI USAGE / AUDIT
// ============================================================

model Subscription {
  id                   String    @id @default(cuid())
  organizationId       String    @unique @map("org_id")
  paypalSubscriptionId String?   @map("paypal_subscription_id")
  plan                 OrgPlan   @default(free)
  status               String    @default("active")
  currentPeriodEnd     DateTime? @map("current_period_end")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([paypalSubscriptionId])
  @@map("subscriptions")
}

model AiUsageLog {
  id               String   @id @default(cuid())
  organizationId   String   @map("org_id")
  feature          String
  provider         String
  tokensUsed       Int      @default(0) @map("tokens_used")
  model            String?
  promptTokens     Int?     @map("prompt_tokens")
  completionTokens Int?     @map("completion_tokens")
  latencyMs        Int?     @map("latency_ms")
  estimatedCostUsd Float?   @map("estimated_cost_usd")
  userId           String?  @map("user_id")
  ticketId         String?  @map("ticket_id")
  cached           Boolean  @default(false)
  createdAt        DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  ticket       Ticket?      @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("ai_usage_logs")
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?  @map("org_id")
  userId         String?  @map("user_id")
  event          String
  metadata       Json     @default("{}")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ============================================================
// ANNOUNCEMENTS
// ============================================================

model Announcement {
  id             String           @id @default(cuid())
  organizationId String           @map("org_id")
  title          String
  content        String
  type           AnnouncementType @default(info)
  isPinned       Boolean          @default(false) @map("is_pinned")
  publishedAt    DateTime?        @default(now()) @map("published_at")
  createdById    String?          @map("created_by")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    Profile?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@map("announcements")
}

// ============================================================
// EMAIL SYSTEM
// ============================================================

model EmailSettings {
  id               String                @id @default(cuid())
  organizationId   String                @unique @map("org_id")
  supportEmail     String?               @map("support_email")
  tenantSlug       String?               @unique @map("tenant_slug")
  displayName      String?               @map("display_name")
  replyTo          String?               @map("reply_to")
  outboundProvider EmailOutboundProvider @default(smtp) @map("outbound_provider")
  providerConfig   Json                  @default("{}") @map("provider_config")
  signatureHtml    String?               @map("signature_html")
  footerHtml       String?               @map("footer_html")
  autoReplyEnabled Boolean               @default(false) @map("auto_reply_enabled")
  autoReplyConfig  Json                  @default("{}") @map("auto_reply_config")
  bounceHandling   Boolean               @default(true) @map("bounce_handling")
  trackingEnabled  Boolean               @default(false) @map("tracking_enabled")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @default(now()) @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("email_settings")
}

model EmailRawInbound {
  id               String                @id @default(cuid())
  organizationId   String?               @map("org_id")
  receivedAt       DateTime              @default(now()) @map("received_at")
  fromAddress      String                @map("from_address")
  toAddress        String                @map("to_address")
  messageId        String?               @unique @map("message_id")
  subject          String?
  payload          Json                  @default("{}")
  processingStatus EmailProcessingStatus @default(pending) @map("processing_status")
  errorMessage     String?               @map("error_message")
  createdAt        DateTime              @default(now()) @map("created_at")

  organization  Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  emailMessages EmailMessage[]

  @@index([organizationId, receivedAt(sort: Desc)])
  @@map("email_raw_inbound")
}

model EmailMessage {
  id                String             @id @default(cuid())
  organizationId    String             @map("org_id")
  ticketId          String?            @map("ticket_id")
  direction         EmailDirection
  messageId         String?            @unique @map("message_id")
  inReplyTo         String?            @map("in_reply_to")
  messageReferences String[]           @default([]) @map("references")
  fromAddress       String             @map("from_address")
  toAddress         String             @map("to_address")
  ccAddresses       String[]           @default([]) @map("cc_addresses")
  replyTo           String?            @map("reply_to")
  subject           String             @default("")
  bodyPlain         String?            @map("body_plain")
  bodyHtml          String?            @map("body_html")
  sanitizedBodyHtml String?            @map("sanitized_body_html")
  provider          String?
  providerMessageId String?            @map("provider_message_id")
  status            EmailMessageStatus @default(pending)
  rawInboundId      String?            @map("raw_inbound_id")
  sentAt            DateTime?          @map("sent_at")
  createdAt         DateTime           @default(now()) @map("created_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket       Ticket?          @relation("EmailMessageTicket", fields: [ticketId], references: [id], onDelete: SetNull)
  rawInbound   EmailRawInbound? @relation(fields: [rawInboundId], references: [id], onDelete: SetNull)

  deliveryEvents   EmailDeliveryEvent[]
  attachments      EmailAttachment[]
  queueItems       EmailQueue[]
  sourceForTickets Ticket[]             @relation("TicketSourceEmail")

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([ticketId])
  @@index([messageId])
  @@index([status])
  @@map("email_messages")
}

model EmailDeliveryEvent {
  id             String                 @id @default(cuid())
  emailMessageId String                 @map("email_message_id")
  eventType      EmailDeliveryEventType @map("event_type")
  occurredAt     DateTime               @default(now()) @map("occurred_at")
  providerData   Json                   @default("{}") @map("provider_data")
  createdAt      DateTime               @default(now()) @map("created_at")

  emailMessage EmailMessage @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)

  @@index([emailMessageId])
  @@index([eventType])
  @@map("email_delivery_events")
}

model EmailAttachment {
  id             String   @id @default(cuid())
  organizationId String   @map("org_id")
  emailMessageId String?  @map("email_message_id")
  ticketId       String?  @map("ticket_id")
  filename       String
  contentType    String   @default("application/octet-stream") @map("content_type")
  sizeBytes      Int      @default(0) @map("size_bytes")
  storagePath    String   @map("storage_path")
  isInline       Boolean  @default(false) @map("is_inline")
  contentId      String?  @map("content_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  emailMessage EmailMessage? @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)
  ticket       Ticket?       @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([emailMessageId])
  @@map("email_attachments")
}

model EmailQueue {
  id             String           @id @default(cuid())
  organizationId String           @map("org_id")
  toAddresses    String[]         @map("to_addresses")
  ccAddresses    String[]         @default([]) @map("cc_addresses")
  fromAddress    String?          @map("from_address")
  replyTo        String?          @map("reply_to")
  subject        String
  bodyHtml       String?          @map("body_html")
  bodyPlain      String?          @map("body_plain")
  templateSlug   String?          @map("template_slug")
  templateVars   Json             @default("{}") @map("template_vars")
  priority       Int              @default(5)
  status         EmailQueueStatus @default(pending)
  retryCount     Int              @default(0) @map("retry_count")
  maxRetries     Int              @default(3) @map("max_retries")
  nextRetryAt    DateTime?        @map("next_retry_at")
  scheduledAt    DateTime?        @map("scheduled_at")
  ticketId       String?          @map("ticket_id")
  emailMessageId String?          @map("email_message_id")
  metadata       Json             @default("{}")
  errorMessage   String?          @map("error_message")
  createdAt      DateTime         @default(now()) @map("created_at")
  processedAt    DateTime?        @map("processed_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket       Ticket?       @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  emailMessage EmailMessage? @relation(fields: [emailMessageId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, priority(sort: Desc)])
  @@index([nextRetryAt])
  @@map("email_queue")
}

model EmailTemplate {
  id             String   @id @default(cuid())
  organizationId String?  @map("org_id")
  slug           String
  name           String
  subject        String
  bodyHtml       String   @map("body_html")
  bodyPlain      String?  @map("body_plain")
  variables      Json     @default("[]")
  isSystem       Boolean  @default(false) @map("is_system")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug])
  @@map("email_templates")
}

// ============================================================
// API KEYS / OUTBOUND WEBHOOKS
// ============================================================

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  createdById    String?   @map("created_by")
  name           String
  keyPrefix      String    @map("key_prefix")
  keyHash        String    @unique @map("key_hash")
  lastUsedAt     DateTime? @map("last_used_at")
  expiresAt      DateTime? @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    Profile?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("api_keys")
}

model OutboundWebhook {
  id             String    @id @default(cuid())
  organizationId String    @map("org_id")
  createdById    String?   @map("created_by")
  name           String
  url            String
  secret         String
  events         String[]  @default([])
  enabled        Boolean   @default(true)
  lastFiredAt    DateTime? @map("last_fired_at")
  lastStatus     Int?      @map("last_status")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    Profile?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("outbound_webhooks")
}
