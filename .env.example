# ──────────────────────────────────────────────────────────────────────────────
# SupportCraft AI — Complete Environment Variables Reference
#
# Copy this file to .env.local for local development, or to .env.production
# for Docker builds. Values marked REQUIRED must be set for the app to function.
# ──────────────────────────────────────────────────────────────────────────────

# ==============================================================================
# CORE APPLICATION SETTINGS
# ==============================================================================

# The canonical URL of your deployed app (used for metadata, OG tags, auth callbacks)
# REQUIRED
NEXT_PUBLIC_APP_URL=https://supportcraft.aakasa.dev

# Admin email addresses (comma-separated) — these users get access to /admin routes
# REQUIRED
ADMIN_EMAILS=admin@aakasa.dev,owner@yourcompany.com

# ==============================================================================
# DATABASE (PostgreSQL via Prisma)
# ==============================================================================

# Connection string for your PostgreSQL database (Neon, Supabase, Railway, etc.)
# Use sslmode=verify-full (not "require") — pg-connection-string currently treats
# "require" as an alias for "verify-full", but that alias goes away in a future
# major version, so this pins the intended (secure) behavior explicitly.
# REQUIRED
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=verify-full

# ==============================================================================
# SUPABASE (Auth, Realtime, Storage for portal/attachments)
# ==============================================================================

# Project URL from Supabase Dashboard → Settings → API
# REQUIRED
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon public key from Supabase Dashboard → Settings → API
# REQUIRED
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key (server-only, NEVER expose to client)
# REQUIRED for server-side admin operations (webhooks, email processor)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==============================================================================
# AUTHENTICATION (NextAuth.js)
# ==============================================================================

# Generate with: openssl rand -base64 32
# REQUIRED
NEXTAUTH_SECRET=your-super-secret-key-at-least-32-chars

# Must match NEXT_PUBLIC_APP_URL exactly (used for OAuth callbacks)
# REQUIRED
NEXTAUTH_URL=https://supportcraft.aakasa.dev

# Google OAuth (optional — for  Sign in with Google)
# Get from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ==============================================================================
# EMAIL — OUTBOUND PROVIDER CONFIGURATION
# ==============================================================================

# Choose one provider: resend | gmail | smtp | sendgrid | mailgun | postmark | ses
# REQUIRED
EMAIL_PROVIDER=resend

# Default sender address (used when no per-org email is configured)
# REQUIRED
EMAIL_FROM=noreply@supportcraft.aakasa.dev

# Shared sending domain (used to construct org emails like acme@supportcraft.aakasa.dev)
# REQUIRED
SENDING_DOMAIN=supportcraft.aakasa.dev

# --- Resend (default, recommended) ---
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXX
RESEND_FROM_EMAIL=noreply@supportcraft.aakasa.dev

# --- Gmail OAuth (for sending via Gmail API) ---
GMAIL_CLIENT_ID=your-gmail-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token

# --- Generic SMTP (SES SMTP, Postfix, etc.) ---
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# --- SendGrid ---
SENDGRID_API_KEY=SG.your-sendgrid-api-key

# --- Mailgun ---
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=supportcraft.aakasa.dev

# --- Postmark ---
POSTMARK_SERVER_TOKEN=your-postmark-server-token

# --- AWS SES (direct API) ---
AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY_ID=your-aws-access-key
AWS_SES_SECRET_ACCESS_KEY=your-aws-secret-key

# ==============================================================================
# EMAIL — INBOUND PROCESSING (Cloudflare Workers + Workers AI)
# ==============================================================================

# Cloudflare account ID (from Cloudflare dashboard)
# REQUIRED for inbound email
R2_ACCOUNT_ID=your-cloudflare-account-id

# R2 credentials for attachment storage
# REQUIRED for inbound email
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=supportcraft-attachments
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Workers AI binding name (for AI-powered spam classification)
# REQUIRED for inbound email
WORKERS_AI_BINDING=AI

# ==============================================================================
# PAYMENTS — PAYPAL
# ==============================================================================

# PayPal Client ID (from PayPal Developer Dashboard)
# REQUIRED for billing/subscriptions
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id

# PayPal Client Secret (server-only)
# REQUIRED for billing/subscriptions
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# PayPal Environment: sandbox or live
# REQUIRED
PAYPAL_ENVIRONMENT=sandbox

# PayPal Webhook ID (for subscription events)
# REQUIRED for billing webhooks
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# PayPal Subscription Plan IDs (monthly)
NEXT_PUBLIC_PAYPAL_PLAN_ID_FREELANCER_MONTHLY=P-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYPAL_PLAN_ID_PRO_MONTHLY=P-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYPAL_PLAN_ID_BUSINESS_MONTHLY=P-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYPAL_PLAN_ID_AGENCY_MONTHLY=P-xxxxxxxxxxxxxxxx

# PayPal Subscription Plan IDs (yearly)
NEXT_PUBLIC_PAYPAL_PLAN_ID_FREELANCER_YEARLY=P-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYPAL_PLAN_ID_PRO_YEARLY=P-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYPAL_PLAN_ID_BUSINESS_YEARLY=P-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYPAL_PLAN_ID_AGENCY_YEARLY=P-xxxxxxxxxxxxxxxx

# ==============================================================================
# FILE STORAGE — CLOUDFLARE R2 (Attachments)
# ==============================================================================

# Same as R2 credentials above — duplicated here for clarity
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=supportcraft-attachments
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# ==============================================================================
# CORS / SECURITY
# ==============================================================================

# Comma-separated list of allowed origins for API routes (if not using wildcard)
# e.g., https://supportcraft.aakasa.dev,https://app.yourcompany.com
ALLOWED_ORIGINS=https://supportcraft.aakasa.dev

# ==============================================================================
# OPTIONAL / ADVANCED
# ==============================================================================

# Turnstile (Cloudflare captcha) — for login/register forms
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Analytics / monitoring
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your-vercel-analytics-id

# Feature flags (comma-separated)
# ENABLE_AI_FEATURES=true
# ENABLE_WEBHOOKS=true

# ==============================================================================
# LEGACY / DEPRECATED (kept for reference)
# ==============================================================================

# Old Supabase-only auth (no longer used — NextAuth handles auth now)
# SUPABASE_JWT_SECRET=...

# Old Stripe integration (replaced by PayPal)
# STRIPE_SECRET_KEY=...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=...