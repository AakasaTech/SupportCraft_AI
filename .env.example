# ============================================================
# SupportCraft AI — Environment Variables
# Copy to .env.local for development, .env.production for Docker
# ============================================================

# ── Supabase ──────────────────────────────────────────────────────────────────
# Dashboard → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI Provider ───────────────────────────────────────────────────────────────
# Set AI_PROVIDER to "openai" or "anthropic"
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── Platform Email (outbound — managed by SupportCraft) ───────────────────────
# Set EMAIL_PROVIDER to: ses | smtp | sendgrid | mailgun | postmark
EMAIL_PROVIDER=ses
SENDING_DOMAIN=supportcraft.aakasa.dev

# AWS SES (when EMAIL_PROVIDER=ses)
AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY_ID=AKIA...
AWS_SES_SECRET_ACCESS_KEY=...

# SMTP / SES-SMTP (when EMAIL_PROVIDER=smtp)
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=...
SMTP_PASS=...

# SendGrid (when EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=SG....

# Mailgun (when EMAIL_PROVIDER=mailgun)
MAILGUN_API_KEY=key-...
MAILGUN_DOMAIN=supportcraft.aakasa.dev

# Postmark (when EMAIL_PROVIDER=postmark)
POSTMARK_SERVER_TOKEN=...

# ── Inbound Email (Cloudflare Worker → Supabase Edge Function → App) ──────────
# Shared secret between Cloudflare Worker, Supabase Edge Function, and this app
INBOUND_SECRET=change-me-to-a-strong-32-byte-random-secret

# ── PayPal ────────────────────────────────────────────────────────────────────
# Sandbox: https://developer.paypal.com/dashboard/
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_WEBHOOK_ID=your-webhook-id
# Subscription plan IDs — create one per tier in PayPal Developer Dashboard
# Monthly plans
NEXT_PUBLIC_PAYPAL_PLAN_ID_FREELANCER_MONTHLY=your-freelancer-monthly-plan-id
NEXT_PUBLIC_PAYPAL_PLAN_ID_PRO=your-startup-monthly-plan-id
NEXT_PUBLIC_PAYPAL_PLAN_ID_BUSINESS=your-business-monthly-plan-id
NEXT_PUBLIC_PAYPAL_PLAN_ID_AGENCY=your-agency-monthly-plan-id
# Yearly plans
NEXT_PUBLIC_PAYPAL_PLAN_ID_FREELANCER_YEARLY=your-freelancer-yearly-plan-id
NEXT_PUBLIC_PAYPAL_PLAN_ID_PRO_YEARLY=your-startup-yearly-plan-id
NEXT_PUBLIC_PAYPAL_PLAN_ID_BUSINESS_YEARLY=your-business-yearly-plan-id
NEXT_PUBLIC_PAYPAL_PLAN_ID_AGENCY_YEARLY=your-agency-yearly-plan-id
# Server-side (webhook verification)
PAYPAL_PLAN_ID_PRO=your-startup-monthly-plan-id
PAYPAL_PLAN_ID_BUSINESS=your-business-monthly-plan-id

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://supportcraft.aakasa.dev

# ── Cron (optional — protects /api/email/queue from public calls) ─────────────
CRON_SECRET=change-me
